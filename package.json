{
  "name": "park-test",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build",
    "preview": "vite preview --host",
    "sprites": "node art/render.mjs",
    "balance": "esbuild tools/balance.ts --bundle --platform=node --log-level=warning --outfile=node_modules/.cache/balance.cjs && node node_modules/.cache/balance.cjs",
    "assets": "esbuild tools/export-assets.ts --bundle --platform=node --log-level=warning --outfile=node_modules/.cache/assets.cjs && node node_modules/.cache/assets.cjs",
    "art": "node art/art.mjs"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
